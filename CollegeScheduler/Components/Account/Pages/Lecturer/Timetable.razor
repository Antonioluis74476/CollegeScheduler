@page "/lecturer/timetable"
@rendermode InteractiveServer
@attribute [Authorize(Roles = RoleNames.Lecturer)]

@using CollegeScheduler.Data.Identity
@using CollegeScheduler.DTOs.Lecturer
@using CollegeScheduler.Services.Interfaces
@using Microsoft.AspNetCore.Authorization

@inject ILecturerService LecturerService

<PageTitle>My Timetable</PageTitle>

<div class="container py-4">

    <div class="d-flex flex-column flex-md-row
                justify-content-between align-items-md-center
                gap-3 mb-4">

        <div>
            <h1 class="h3 mb-1">My Timetable</h1>

            <p class="text-muted mb-0">
                View your scheduled teaching sessions for the selected week.
            </p>
        </div>

        <div class="btn-group">

            <button type="button"
                    class="btn btn-outline-secondary"
                    @onclick="PreviousWeek"
                    disabled="@_isLoading">
                Previous
            </button>

            <button type="button"
                    class="btn btn-outline-primary"
                    @onclick="CurrentWeek"
                    disabled="@_isLoading">
                Current week
            </button>

            <button type="button"
                    class="btn btn-outline-secondary"
                    @onclick="NextWeek"
                    disabled="@_isLoading">
                Next
            </button>

        </div>

    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <strong>Week:</strong>

            @_weekStart.ToString("dd MMM yyyy")
            -
            @_weekEnd.ToString("dd MMM yyyy")

        </div>
    </div>

    @if (_isLoading)
    {
        <div class="d-flex align-items-center gap-2">

            <div class="spinner-border spinner-border-sm"
                 role="status">
                <span class="visually-hidden">Loading...</span>
            </div>

            <span>Loading timetable...</span>

        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger"
             role="alert">
            @_errorMessage
        </div>
    }
    else if (_items.Count == 0)
    {
        <div class="alert alert-info"
             role="alert">
            No timetable events were found for this week.
        </div>
    }
    else
    {
        @foreach (var dayGroup in _items
            .OrderBy(x => x.StartUtc)
            .GroupBy(x => x.StartUtc.ToLocalTime().Date))
        {
            <div class="mb-4">

                <h2 class="h5 border-bottom pb-2">
                    @dayGroup.Key.ToString("dddd, dd MMMM yyyy")
                </h2>

                <div class="row g-3">

                    @foreach (var item in dayGroup.OrderBy(x => x.StartUtc))
                    {
                        <div class="col-12">

                            <div class="card shadow-sm">
                                <div class="card-body">

                                    <div class="d-flex flex-column
                                                            flex-md-row
                                                            justify-content-between
                                                            gap-3">

                                        <div>

                                            <h3 class="h6 mb-2">
                                                @GetSessionType(item)
                                            </h3>

                                            <div class="text-muted">
                                                Module:
                                                <strong>@item.ModuleCode - @item.ModuleTitle</strong>
                                            </div>

                                            <div class="text-muted">
                                                Room:
                                                <strong>
                                                    @item.RoomCode
                                                    @if (!string.IsNullOrWhiteSpace(item.RoomName))
                                                    {
                                                        <span>- @item.RoomName</span>
                                                    }
                                            </strong>
                                        </div>

                                        </div>

                                        <div class="text-md-end">

                                            <div class="fw-semibold fs-5">
                                                @(item.StartUtc
                                                                                    .ToLocalTime()
                                                                                    .ToString("HH:mm"))
                                                                                                       -
                                                @(item.EndUtc
                                                                                    .ToLocalTime()
                                                                                    .ToString("HH:mm"))
                                </div>

                                            <span class="badge bg-secondary mt-2">
                                                @item.StatusName
                                            </span>

                                            <div class="mt-3">
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-primary"
                                                        @onclick="() => OpenDetails(item)">
                                                    View Details
                                                </button>
                                            </div>

                                        </div>

                                    </div>

                                </div>
                            </div>

                        </div>
                    }

                </div>

            </div>
        }
    }

</div>

@if (_selectedEvent is not null)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         role="dialog"
         aria-modal="true">

        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content shadow">

                <div class="modal-header">
                    <div>
                        <h2 class="modal-title h5 mb-1">
                            Class Details
                        </h2>

                        <div class="text-muted">
                            @_selectedEvent.ModuleCode -
                            @_selectedEvent.ModuleTitle
                        </div>
                    </div>

                    <button type="button"
                            class="btn-close"
                            aria-label="Close"
                            @onclick="CloseDetails">
                    </button>
                </div>

                <div class="modal-body">

                    <div class="row g-3">

                        <div class="col-md-6">
                            <div class="text-muted small">Module</div>
                            <div class="fw-semibold">
                                @_selectedEvent.ModuleCode -
                                @_selectedEvent.ModuleTitle
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="text-muted small">Session type</div>
                            <div class="fw-semibold">
                                @GetSessionType(_selectedEvent)
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="text-muted small">Date</div>
                            <div class="fw-semibold">
                                @(_selectedEvent.StartUtc
                                     .ToLocalTime()
                                     .ToString("dddd, dd MMMM yyyy"))
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="text-muted small">Time</div>
                            <div class="fw-semibold">
                                @(_selectedEvent.StartUtc
                                     .ToLocalTime()
                                     .ToString("HH:mm"))
                                                                               -
                                @(_selectedEvent.EndUtc
                                     .ToLocalTime()
                                     .ToString("HH:mm"))
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="text-muted small">Duration</div>
                            <div class="fw-semibold">
                                @GetDuration(_selectedEvent)
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="text-muted small">Status</div>
                            <span class="badge bg-secondary">
                                @_selectedEvent.StatusName
                            </span>
                        </div>

                        <div class="col-12">
                            <div class="text-muted small">Room</div>
                            <div class="fw-semibold">
                                @_selectedEvent.RoomCode

                                @if (!string.IsNullOrWhiteSpace(
                                                            _selectedEvent.RoomName))
                                {
                                    <span>
                                        - @_selectedEvent.RoomName
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="text-muted small">Notes</div>
                            <div class="fw-semibold">
                                @GetDisplayNotes(_selectedEvent)
                            </div>
                        </div>

                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="CloseDetails">
                        Close
                    </button>
                </div>

            </div>
        </div>
    </div>

    <div class="modal-backdrop fade show"
         @onclick="CloseDetails">
    </div>
}

@code {
    private readonly List<LecturerTimetableItemDto> _items = [];

    private bool _isLoading = true;
    private string? _errorMessage;

    private LecturerTimetableItemDto? _selectedEvent;

    private DateTime _weekStart;
    private DateTime _weekEnd;

    protected override async Task OnInitializedAsync()
    {
        SetWeek(DateTime.Today);
        await LoadTimetableAsync();
    }

    private void SetWeek(DateTime date)
    {
        var difference =
            (7 + (date.DayOfWeek - DayOfWeek.Monday)) % 7;

        _weekStart = date.Date.AddDays(-difference);
        _weekEnd = _weekStart.AddDays(6);
    }

    private async Task LoadTimetableAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var fromUtc = DateTime.SpecifyKind(
                    _weekStart,
                    DateTimeKind.Local)
                .ToUniversalTime();

            var toUtc = DateTime.SpecifyKind(
                    _weekEnd.AddDays(1).AddTicks(-1),
                    DateTimeKind.Local)
                .ToUniversalTime();

            var results = await LecturerService.GetTimetableAsync(
                fromUtc,
                toUtc);

            _items.Clear();
            _items.AddRange(results);
        }
        catch (HttpRequestException ex)
        {
            _errorMessage = CleanErrorMessage(ex.Message);
        }
        catch (Exception)
        {
            _errorMessage =
                "An unexpected error occurred while loading the timetable.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task PreviousWeek()
    {
        _weekStart = _weekStart.AddDays(-7);
        _weekEnd = _weekEnd.AddDays(-7);

        await LoadTimetableAsync();
    }

    private async Task CurrentWeek()
    {
        SetWeek(DateTime.Today);
        await LoadTimetableAsync();
    }

    private async Task NextWeek()
    {
        _weekStart = _weekStart.AddDays(7);
        _weekEnd = _weekEnd.AddDays(7);

        await LoadTimetableAsync();
    }

    private static string GetSessionType(
        LecturerTimetableItemDto item)
    {
        return string.IsNullOrWhiteSpace(item.SessionType)
            ? "Class"
            : item.SessionType;
    }

    private static string CleanErrorMessage(string message)
    {
        return string.IsNullOrWhiteSpace(message)
            ? "The timetable could not be loaded."
            : message.Trim('"');
    }

    private void OpenDetails(LecturerTimetableItemDto item)
    {
        _selectedEvent = item;
    }

    private void CloseDetails()
    {
        _selectedEvent = null;
    }

    private static string GetDuration(
        LecturerTimetableItemDto item)
    {
        var duration =
            item.EndUtc.ToLocalTime() -
            item.StartUtc.ToLocalTime();

        if (duration.TotalMinutes < 60)
        {
            return $"{duration.TotalMinutes:0} minutes";
        }

        if (duration.Minutes == 0)
        {
            return duration.TotalHours == 1
                ? "1 hour"
                : $"{duration.TotalHours:0} hours";
        }

        return $"{(int)duration.TotalHours} hour(s) " +
               $"{duration.Minutes} minutes";
    }

    private static string GetDisplayNotes(
        LecturerTimetableItemDto item)
    {
        if (string.IsNullOrWhiteSpace(item.Notes))
        {
            return "No additional notes.";
        }

        if (item.Notes.StartsWith(
            "Generated timetable session for cohort",
            StringComparison.OrdinalIgnoreCase))
        {
            return "Recurring scheduled class.";
        }

        return item.Notes;
    }

}