@page "/lecturer/dashboard"
@rendermode InteractiveServer
@attribute [Authorize(Roles = RoleNames.Lecturer)]

@using CollegeScheduler.Data.Identity
@using CollegeScheduler.DTOs.Lecturer
@using CollegeScheduler.Services.Interfaces
@using Microsoft.AspNetCore.Authorization

@inject ILecturerService LecturerService

<PageTitle>Lecturer Dashboard</PageTitle>

<div class="mb-4">
    <h1 class="mb-1">
        Welcome back@(profile is not null ? $", {profile.Name}!" : "!")
    </h1>

    <p class="text-muted mb-0">
        Here are your next teaching sessions.
    </p>
</div>

@if (isLoading)
{
    <p><em>Loading teaching sessions...</em></p>
}
else
{
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="fw-semibold">
                Upcoming Classes
            </span>

            <span class="badge bg-primary">
                @upcomingSessions.Count Session@(upcomingSessions.Count == 1 ? "" : "s")
            </span>
        </div>

        <div class="card-body">
            @if (!upcomingSessions.Any())
            {
                <p class="text-muted mb-0">
                    No upcoming teaching sessions found.
                </p>
            }
            else
            {
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Module</th>
                            <th>Room</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in upcomingSessions)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">
                                        @item.StartUtc.ToLocalTime().ToString("dddd")
                                    </div>

                                    <small class="text-muted">
                                        @item.StartUtc.ToLocalTime().ToString("dd MMM yyyy")
                                    </small>
                                </td>

                                <td>
                                    @item.StartUtc.ToLocalTime().ToString("HH:mm")
                                    -
                                    @item.EndUtc.ToLocalTime().ToString("HH:mm")
                                </td>

                                <td>@item.ModuleTitle</td>
                                <td>@item.RoomCode</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@code
{
    private LecturerProfileDto? profile;

    private bool isLoading = true;

    private List<LecturerTimetableItemDto> upcomingSessions = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            profile = await LecturerService.GetProfileAsync();

            var fromDate = DateTime.UtcNow;
            var toDate = fromDate.AddDays(60);

            var timetable = await LecturerService.GetTimetableAsync(fromDate, toDate);

            upcomingSessions = timetable
                .Where(x => x.StartUtc >= DateTime.UtcNow)
                .OrderBy(x => x.StartUtc)
                .Take(5)
                .ToList();
        }
        finally
        {
            isLoading = false;
        }
    }
}