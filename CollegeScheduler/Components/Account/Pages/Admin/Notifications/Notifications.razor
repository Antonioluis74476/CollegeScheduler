@page "/admin/notifications"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

@using CollegeScheduler.DTOs.Notifications
@using CollegeScheduler.Services.Interfaces
@using Microsoft.AspNetCore.Authorization

@inject IAdminNotificationService NotificationService

<PageTitle>Notification Centre</PageTitle>

<h1 class="mb-4">Notification Centre</h1>

<div class="card shadow-sm">

    <div class="card-header">
        <strong>Notifications</strong>
    </div>

    <div class="card-body">

        @if (isLoading)
        {
            <p>Loading notifications...</p>
        }
        else if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger">
                @errorMessage
            </div>
        }
        else if (notifications.Count == 0)
        {
            <div class="alert alert-info mb-0">
                No notifications were found.
            </div>
        }
        else
        {
            <table class="table table-striped table-hover">

                <thead>

                    <tr>
                        <th>Title</th>
                        <th>Type</th>
                        <th>Message</th>
                        <th>Recipients</th>
                        <th>Delivery</th>
                        <th></th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var notification in notifications)
                    {
                        <tr>

                            <td>@notification.Title</td>

                            <td>
                                @GetNotificationTypeName(notification.NotificationTypeId)
                            </td>

                            <td>@notification.Message</td>

                            <td>@notification.Recipients.Count</td>

                            <td>@GetDeliverySummary(notification)</td>

                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary"
                                        @onclick="() => SelectNotificationAsync(notification.NotificationId)">
                                    View
                                </button>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        }

        @if (isLoadingDetails)
        {
            <div class="card shadow-sm mt-4">
                <div class="card-body">
                    Loading notification details...
                </div>
            </div>
        }
        else if (selectedNotification is not null)
        {
            <div class="card shadow-sm mt-4">

                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Notification Details</strong>

                    <button class="btn btn-sm btn-outline-secondary"
                            @onclick="CloseDetails">
                        Close
                    </button>
                </div>

                <div class="card-body">

                    <h4>@selectedNotification.Title</h4>

                    <p class="text-muted mb-3">
                        @GetNotificationTypeName(selectedNotification.NotificationTypeId)
                    </p>

                    <p>@selectedNotification.Message</p>

                    <hr />

                    <h5>Recipients</h5>

                    @if (selectedNotification.Recipients.Count == 0)
                    {
                        <div class="alert alert-info mb-0">
                            No recipients were attached to this notification.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">

                                <thead>
                                    <tr>
                                        <th>Status</th>
                                        <th>Sent</th>
                                        <th>Read</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var recipient in selectedNotification.Recipients)
                                    {
                                        <tr>
                                            <td>@recipient.DeliveryStatus</td>

                                            <td>
                                                @(recipient.SentAtUtc.HasValue
                                                                                    ? recipient.SentAtUtc.Value.ToLocalTime()
                                                                                    .ToString("dd MMM yyyy HH:mm")
                                                                                    : "Not sent")
                                                                                             </td>

                                            <td>
                                                @(recipient.ReadAtUtc.HasValue
                                                                                    ? recipient.ReadAtUtc.Value.ToLocalTime()
                                                                                    .ToString("dd MMM yyyy HH:mm")
                                                                                    : "Unread")
                                </td>
                            </tr>
                                                        }
                                </tbody>

                            </table>
                        </div>
                    }

                </div>

            </div>
        }

    </div>

</div>

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private List<NotificationDto> notifications = new();

    private List<NotificationTypeDto> notificationTypes = new();

    private NotificationDto? selectedNotification;
    private bool isLoadingDetails;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var notificationsResult = await NotificationService.GetNotificationsAsync();

            notifications = notificationsResult?.Items
                ?? new List<NotificationDto>();

            notificationTypes =
                await NotificationService.GetNotificationTypesAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not load notifications: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetNotificationTypeName(int notificationTypeId)
    {
        return notificationTypes
            .FirstOrDefault(type =>
                type.NotificationTypeId == notificationTypeId)
            ?.Name
            ?? "Unknown type";
    }

    private string GetDeliverySummary(NotificationDto notification)
    {
        if (notification.Recipients.Count == 0)
            return "No recipients";

        var readCount = notification.Recipients.Count(r =>
            !string.IsNullOrWhiteSpace(r.ReadAtUtc?.ToString()));

        var sentCount = notification.Recipients.Count(r =>
            !string.IsNullOrWhiteSpace(r.SentAtUtc?.ToString()));

        var pendingCount = notification.Recipients.Count(r =>
            string.Equals(
                r.DeliveryStatus,
                "Pending",
                StringComparison.OrdinalIgnoreCase));

        if (readCount > 0)
            return $"{readCount} read";

        if (sentCount > 0)
            return $"{sentCount} sent";

        if (pendingCount > 0)
            return $"{pendingCount} pending";

        return "Not delivered";
    }

    private async Task SelectNotificationAsync(long notificationId)
    {
        try
        {
            isLoadingDetails = true;
            errorMessage = null;

            selectedNotification =
                await NotificationService.GetNotificationByIdAsync(notificationId);
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not load notification details: {ex.Message}";
        }
        finally
        {
            isLoadingDetails = false;
        }
    }

    private void CloseDetails()
    {
        selectedNotification = null;
    }

}