@page "/admin/audit-logs"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

@using CollegeScheduler.DTOs.Audit
@using CollegeScheduler.DTOs.Common


@using Microsoft.AspNetCore.Authorization

@inject CollegeScheduler.Services.IAuditLogService AuditLogService


<PageTitle>Audit Logs</PageTitle>

<h3>Audit Logs</h3>

@if (_loading)
{
    <p><em>Loading...</em></p>
}
else if (_result is null || !_result.Items.Any())
{
    <div class="alert alert-info">
        No audit logs found.
    </div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Date (UTC)</th>
                <th>User</th>
                <th>Action</th>
                <th>Entity</th>
                <th>Entity ID</th>
                <th>IP Address</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var log in _result.Items)
            {
                <tr>
                    <td>@log.AuditLogId</td>
                    <td>@log.PerformedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@log.UserId</td>
                    <td>@log.Action</td>
                    <td>@log.EntityType</td>
                    <td>@log.EntityId</td>
                    <td>@log.IpAddress</td>
                    <td>
                        <a class="btn btn-sm btn-primary"
                           href="@($"/admin/audit-logs/{log.AuditLogId}")">
                            Details
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <p>
        Showing @_result.Items.Count of @_result.TotalCount records.
    </p>
}

@code
{
    private PagedResult<AuditLogDto>? _result;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _result = await AuditLogService.GetAuditLogsAsync();
        _loading = false;
    }
}