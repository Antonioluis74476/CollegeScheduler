@page "/admin/request-types/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]

@using CollegeScheduler.DTOs.Requests
@using CollegeScheduler.Services.Interfaces
@using Microsoft.AspNetCore.Authorization

@inject IRequestTypeService RequestTypeService
@inject NavigationManager Navigation

<PageTitle>Request Type Details</PageTitle>

<div class="container mt-4">
    <h2>Request Type Details</h2>

    @if (isLoading)
    {
        <p>Loading request type...</p>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>

        <button class="btn btn-secondary"
                @onclick="GoBack">
            Back
        </button>
    }
    else if (requestType is not null)
    {
        <table class="table table-bordered mt-3">
            <tbody>
                <tr>
                    <th style="width: 220px;">Name</th>
                    <td>@requestType.Name</td>
                </tr>

                <tr>
                    <th>Status</th>
                    <td>
                        @if (requestType.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </td>
                </tr>
            </tbody>
        </table>

        <button class="btn btn-warning me-2"
                @onclick="Edit">
            Edit
        </button>

        @if (requestType.IsActive)
        {
            <button class="btn btn-danger me-2"
                    @onclick="Delete">
                Delete
            </button>
        }

        <button class="btn btn-secondary"
                @onclick="GoBack">
            Back
        </button>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private RequestTypeDto? requestType;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            requestType = await RequestTypeService.GetByIdAsync(Id);

            if (requestType is null)
            {
                errorMessage = "Request type not found.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load request type: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void Edit()
    {
        Navigation.NavigateTo($"/admin/request-types/{Id}/edit");
    }

    private void Delete()
    {
        Navigation.NavigateTo($"/admin/request-types/{Id}/delete");
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/admin/request-types");
    }
}