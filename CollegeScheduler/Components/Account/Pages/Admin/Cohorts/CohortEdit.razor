@page "/admin/cohorts/edit/{CohortId:int}"
@attribute [Authorize(Roles = "Admin")]

@using Microsoft.AspNetCore.Authorization
@using CollegeScheduler.DTOs.Academic
@using CollegeScheduler.Services.Interfaces

@inject ICohortService CohortService
@inject NavigationManager Navigation

<h3>Edit Cohort</h3>

@if (_loading)
{
    <p>Loading...</p>
}
else if (_model is null)
{
    <div class="alert alert-danger">
        Cohort not found.
    </div>
}
else
{
    <EditForm Model="_model"
              OnValidSubmit="SaveAsync"
              FormName="EditCohortForm">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Code</label>
            <InputText class="form-control" @bind-Value="_model.Code" />
        </div>

        <div class="mb-3">
            <label class="form-label">Name</label>
            <InputText class="form-control" @bind-Value="_model.Name" />
        </div>

        <div class="mb-3">
            <label class="form-label">Year of Study</label>
            <InputNumber class="form-control" @bind-Value="_model.YearOfStudy" />
        </div>

        <div class="mb-3">
            <label class="form-label">Expected Size</label>
            <InputNumber class="form-control" @bind-Value="_model.ExpectedSize" />
        </div>

        <div class="form-check mb-3">
            <InputCheckbox class="form-check-input" @bind-Value="_model.IsActive" />
            <label class="form-check-label">
                Active
            </label>
        </div>

        <button class="btn btn-primary" type="submit">
            Save
        </button>

        <a class="btn btn-secondary ms-2"
           href="@($"/admin/cohorts/{_programId}")">
            Cancel
        </a>

    </EditForm>
}

@code {

    [Parameter]
    public int CohortId { get; set; }

    private bool _loading = true;

    private CohortUpdateDto? _model;

    private int _programId;

    protected override async Task OnInitializedAsync()
    {
        var cohort = await CohortService.GetByIdAsync(CohortId);

        if (cohort != null)
        {
            _programId = cohort.ProgramId;

            _model = new CohortUpdateDto
            {
                AcademicYearId = cohort.AcademicYearId,
                YearOfStudy = cohort.YearOfStudy,
                Code = cohort.Code,
                Name = cohort.Name,
                ExpectedSize = cohort.ExpectedSize,
                IsActive = cohort.IsActive
            };
        }

        _loading = false;
    }

    private async Task SaveAsync()
    {
        if (_model == null)
            return;

        var success = await CohortService.UpdateAsync(CohortId, _model);

        if (success)
        {
            Navigation.NavigateTo($"/admin/cohorts/{_programId}");
        }
    }

}