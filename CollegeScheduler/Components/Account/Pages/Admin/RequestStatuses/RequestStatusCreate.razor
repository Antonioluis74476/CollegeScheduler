@page "/admin/request-statuses/create"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using CollegeScheduler.DTOs.Requests
@using CollegeScheduler.Services.Admin

@inject IRequestStatusService RequestStatusService
@inject NavigationManager Navigation

<PageTitle>Create Request Status</PageTitle>

<h3>Create Request Status</h3>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger">
        @_errorMessage
    </div>
}

<EditForm Model="_model"
          OnValidSubmit="CreateStatus">

    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Name</label>

        <InputText class="form-control"
                   @bind-Value="_model.Name" />
    </div>

    <button type="submit"
            class="btn btn-primary me-2"
            disabled="@_isSaving">
        @(_isSaving ? "Saving..." : "Create")
    </button>

    <button type="button"
            class="btn btn-secondary"
            @onclick="GoBack">
        Cancel
    </button>
</EditForm>

@code
{
    private RequestStatusCreateDto _model = new();
    private string? _errorMessage;
    private bool _isSaving;

    private async Task CreateStatus()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_model.Name))
        {
            _errorMessage = "Name is required.";
            return;
        }

        _isSaving = true;

        var success = await RequestStatusService.CreateAsync(_model.Name);

        _isSaving = false;

        if (success)
        {
            Navigation.NavigateTo("/admin/request-statuses");
            return;
        }

        _errorMessage = "The request status could not be created.";
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/admin/request-statuses");
    }
}