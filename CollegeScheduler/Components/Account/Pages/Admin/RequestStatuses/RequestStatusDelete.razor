@page "/admin/request-statuses/delete/{Id:int}"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using CollegeScheduler.DTOs.Requests
@using CollegeScheduler.Services.Admin

@inject IRequestStatusService RequestStatusService
@inject NavigationManager Navigation

<PageTitle>Delete Request Status</PageTitle>

<h3>Delete Request Status</h3>

@if (_isLoading)
{
    <p><em>Loading...</em></p>
}
else if (_status is null)
{
    <div class="alert alert-warning">
        Request status not found.
    </div>

    <button class="btn btn-secondary"
            @onclick="GoBack">
        Back
    </button>
}
else
{
    <div class="alert alert-danger">
        <strong>Are you sure you want to delete this request status?</strong>
    </div>

    <table class="table table-bordered">
        <tbody>
            <tr>
                <th style="width:200px;">Name</th>
                <td>@_status.Name</td>
            </tr>

            <tr>
                <th>Status</th>
                <td>
                    @if (_status.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </td>
            </tr>
        </tbody>
    </table>

    <button class="btn btn-danger me-2"
            @onclick="Delete">
        Delete
    </button>

    <button class="btn btn-secondary"
            @onclick="GoBack">
        Cancel
    </button>
}

@code
{
    [Parameter]
    public int Id { get; set; }

    private RequestStatusDto? _status;
    private bool _isLoading = true;
    private bool _isDeleting;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _status = await RequestStatusService.GetByIdAsync(Id);
        _isLoading = false;
    }

    private async Task Delete()
    {
        if (_isDeleting)
            return;

        _isDeleting = true;

        var success = await RequestStatusService.DeleteAsync(Id);

        _isDeleting = false;

        if (success)
        {
            Navigation.NavigateTo("/admin/request-statuses");
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/admin/request-statuses");
    }
}