@page "/admin/request-statuses/edit/{Id:int}"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using CollegeScheduler.DTOs.Requests
@using CollegeScheduler.Services.Admin

@inject IRequestStatusService RequestStatusService
@inject NavigationManager Navigation

<PageTitle>Edit Request Status</PageTitle>

<h3>Edit Request Status</h3>

@if (_isLoading)
{
    <p><em>Loading...</em></p>
}
else if (_model is null)
{
    <div class="alert alert-warning">
        Request status not found.
    </div>

    <button class="btn btn-secondary"
            @onclick="GoBack">
        Back
    </button>
}
else
{
    <EditForm Model="_model"
              OnValidSubmit="Save">

        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Name</label>

            <InputText class="form-control"
                       @bind-Value="_model.Name" />
        </div>

        <div class="form-check mb-3">
            <InputCheckbox class="form-check-input"
                           @bind-Value="_model.IsActive" />

            <label class="form-check-label">
                Active
            </label>
        </div>

        <button class="btn btn-primary me-2"
                type="submit"
                disabled="@_isSaving">
            @(_isSaving ? "Saving..." : "Save")
        </button>

        <button class="btn btn-secondary"
                type="button"
                @onclick="GoBack">
            Cancel
        </button>
    </EditForm>
}

@code
{
    [Parameter]
    public int Id { get; set; }

    private RequestStatusUpdateDto? _model;
    private bool _isLoading = true;
    private bool _isSaving;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;

        var status = await RequestStatusService.GetByIdAsync(Id);

        if (status is not null)
        {
            _model = new RequestStatusUpdateDto
            {
                Name = status.Name,
                IsActive = status.IsActive
            };
        }

        _isLoading = false;
    }

    private async Task Save()
    {
        if (_model is null)
            return;

        _isSaving = true;

        var success = await RequestStatusService.UpdateAsync(
            Id,
            _model.Name,
            _model.IsActive);

        _isSaving = false;

        if (success)
        {
            Navigation.NavigateTo("/admin/request-statuses");
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/admin/request-statuses");
    }
}