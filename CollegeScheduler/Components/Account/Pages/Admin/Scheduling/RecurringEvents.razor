@page "/admin/scheduling/recurring-events"
@rendermode InteractiveServer
@using CollegeScheduler.DTOs.Scheduling
@using CollegeScheduler.DTOs.Facilities
@using CollegeScheduler.DTOs.Academic
@using CollegeScheduler.DTOs.Profiles


@inject CollegeScheduler.Services.Interfaces.IAdminSchedulingService SchedulingService

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <small class="text-muted">Scheduling /</small>
        <h3 class="mb-0">Recurring Events Creator</h3>
    </div>

    <a href="/admin/scheduling" class="btn btn-outline-secondary">
        ← Back
    </a>
</div>

<div class="mb-3">
    <label>Term:</label>
    <select class="form-control" @bind="termId">
        <option value="">-- Select Term --</option>

        @if (termsResult?.Items != null)
        {
            @foreach (var term in termsResult.Items)
            {
                <option value="@term.TermId">@term.Name</option>
            }
        }
    </select>
</div>

<div class="mb-3">
    <label>Module:</label>
    <select class="form-control" @bind="moduleId">
        <option value="">-- Select Module --</option>

        @if (modulesResult?.Items != null)
        {
            @foreach (var module in modulesResult.Items)
            {
                <option value="@module.ModuleId">
                    @module.Code - @module.Title
                </option>
            }
        }
    </select>
</div>

<div class="mb-3">
    <label class="form-label">Campus</label>

    <select class="form-select"
            value="@campusId"
            @onchange="OnCampusChanged">

        <option value="0">-- Select Campus --</option>

        @if (campusesResult?.Items is not null)
        {
            @foreach (var campus in campusesResult.Items)
            {
                <option value="@campus.CampusId">
                    @campus.Code - @campus.Name
                </option>
            }
        }
    </select>
</div>

<div class="mb-3">
    <label class="form-label">Building</label>

    <select class="form-select"
            value="@buildingId"
            @onchange="OnBuildingChanged"
            disabled="@(campusId == 0)">

        <option value="0">-- Select Building --</option>

        @if (buildingsResult?.Items is not null)
        {
            @foreach (var building in buildingsResult.Items)
            {
                <option value="@building.BuildingId">
                    @building.Code - @building.Name
                </option>
            }
        }
    </select>
</div>

<div class="mb-3">
    <label class="form-label">Room:</label>

    <select class="form-control" @bind="roomId">
        <option value="0">-- Select Room --</option>

        @if (roomsResult?.Items != null)
        {
            @foreach (var room in roomsResult.Items)
            {
                <option value="@room.RoomId">
                    @room.Code - @room.Name
                </option>
            }
        }
    </select>
</div>

<div class="mb-3">
    <label class="form-label">First Event Start:</label>
    <input type="datetime-local"
           class="form-control"
           @bind="startLocal" />
</div>

<div class="mb-3">
    <label class="form-label">First Event End:</label>
    <input type="datetime-local"
           class="form-control"
           @bind="endLocal" />
</div>

<div class="mb-3">
    <label>Event Status:</label>
    <select class="form-control" @bind="eventStatusId">
        <option value="">-- Select Event Status --</option>

        @if (eventStatusesResult?.Items != null)
        {
            @foreach (var status in eventStatusesResult.Items)
            {
                <option value="@status.EventStatusId">@status.Name</option>
            }
        }
    </select>
</div>

<div class="mb-3">
    <label>Session Type:</label>
    <input type="text" class="form-control" @bind="sessionType" />
</div>

<div class="mb-3">
    <label>Notes:</label>
    <input type="text" class="form-control" @bind="notes" />
</div>

<div class="mb-3">
    <label class="form-label">Department</label>

    <select class="form-select"
            value="@departmentId"
            @onchange="OnDepartmentChanged">

        <option value="0">-- Select Department --</option>

        @if (departmentsResult?.Items is not null)
        {
            @foreach (var department in departmentsResult.Items)
            {
                <option value="@department.DepartmentId">
                    @department.Code - @department.Name
                </option>
            }
        }
    </select>
</div>

<div class="mb-3">
    <label class="form-label">Program</label>

    <select class="form-control"
            value="@programId"
            @onchange="OnProgramChanged">
        <option value="0">-- Select Program --</option>

        @if (programsResult?.Items != null)
        {
            @foreach (var program in programsResult.Items)
            {
                <option value="@program.ProgramId">
                    @program.Code - @program.Name
                </option>
            }
        }
    </select>
</div>

<div class="mb-3">
    <label class="form-label">Cohorts</label>

    @if (programId == 0)
    {
        <div class="text-muted">
            Select a program first.
        </div>
    }
    else if (cohortsResult?.Items == null || cohortsResult.Items.Count == 0)
    {
        <div class="text-muted">
            No cohorts found for this program.
        </div>
    }
    else
    {
        @foreach (var cohort in cohortsResult.Items)
        {
            <div class="form-check">
                <input class="form-check-input"
                       type="checkbox"
                       checked="@selectedCohortIds.Contains(cohort.CohortId)"
                       @onchange="e => ToggleCohort(cohort.CohortId, e)" />

                <label class="form-check-label">
                    @cohort.Code - @cohort.Name
                </label>
            </div>
        }
    }
</div>

<div class="mb-3">
    <label class="form-label">Lecturers</label>

    @if (lecturersResult?.Items == null || lecturersResult.Items.Count == 0)
    {
        <div class="text-muted">
            No lecturers found.
        </div>
    }
    else
    {
        <select class="form-select"
                multiple
                size="6"
                @onchange="OnLecturersChanged">

            @foreach (var lecturer in FilteredLecturers)
            {
                <option value="@lecturer.LecturerId">
                    @lecturer.StaffNumber - @lecturer.Name @lecturer.LastName
                </option>
            }
        </select>

        <small class="text-muted">
            Hold Ctrl to select more than one lecturer.
        </small>
    }
</div>

<button class="btn btn-success" @onclick="CreateRecurringEvents">
    Create Recurring Events
</button>

@if (result != null)
{
    <div class="alert alert-success mt-3">
        <p><strong>Created:</strong> @result.CreatedCount events</p>
        <p><strong>Group ID:</strong> @result.RecurrenceGroupId</p>
    </div>
}

@if (errorMessage != null)
{
    <div class="alert alert-danger mt-3">
        @errorMessage
    </div>
}

@code {
    private int termId;
    private int moduleId;
    private int roomId;
    private int eventStatusId;

    private EventStatusDtoPagedResult? eventStatusesResult;

    private RoomDtoPagedResult? roomsResult;
    private int buildingId; //

    private ModuleDtoPagedResult? modulesResult;

    private TermDtoPagedResult? termsResult;
    private int academicYearId = 2;

    private CollegeScheduler.Services.PagedResult<DepartmentDto>? departmentsResult;
    private int departmentId;

    private CollegeScheduler.Services.PagedResult<ProgramDto>? programsResult;

    private CollegeScheduler.Services.PagedResult<CohortDto>? cohortsResult;

    private int programId;

    private string sessionType = "Lecture";
    private string? notes;

    private string cohortIdsText = "";
    private string lecturerIdsText = "";

    private DateTime startLocal;
    private DateTime endLocal;

    private RecurringEventCreateResultDto? result;
    private string? errorMessage;

    private List<int> selectedCohortIds = new();

    private CollegeScheduler.Services.PagedResult<LecturerDto>? lecturersResult;

    private List<int> selectedLecturerIds = new();

    private CollegeScheduler.Services.PagedResult<CampusDto>? campusesResult;
    private CollegeScheduler.Services.PagedResult<BuildingDto>? buildingsResult;

    private int campusId;

    private async Task CreateRecurringEvents()
    {
        try
        {
            var dto = new RecurringEventCreateDto
            {
                TermId = termId,
                ModuleId = moduleId,
                RoomId = roomId,
                FirstOccurrenceStartUtc = new DateTime(
                    startLocal.Year,
                    startLocal.Month,
                    startLocal.Day,
                    startLocal.Hour,
                    startLocal.Minute,
                    0,
                    DateTimeKind.Utc),

                FirstOccurrenceEndUtc = new DateTime(
                    endLocal.Year,
                    endLocal.Month,
                    endLocal.Day,
                    endLocal.Hour,
                    endLocal.Minute,
                    0,
                    DateTimeKind.Utc),
                EventStatusId = eventStatusId,
                SessionType = sessionType,
                Notes = notes,
                CohortIds = selectedCohortIds.ToList(),
                LecturerIds = selectedLecturerIds.ToList(),
            };

            result = await SchedulingService.CreateRecurringEventsAsync(dto);

            if (result is null)
            {
                errorMessage = "The API rejected the request. Check the IDs and required values.";
            }
            else
            {
                errorMessage = null;
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            result = null;
        }
    }

    private List<int> ParseIds(string input)
    {
        return input
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(x => int.Parse(x.Trim()))
            .ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        eventStatusesResult = await SchedulingService.GetEventStatusesAsync();
        campusesResult = await SchedulingService.GetCampusesAsync();
        modulesResult = await SchedulingService.GetModulesAsync();
        termsResult = await SchedulingService.GetTermsByAcademicYearAsync(academicYearId);

        departmentsResult = await SchedulingService.GetDepartmentsAsync();

        lecturersResult = await SchedulingService.GetLecturersAsync();

    }

    private async Task OnCampusChanged(ChangeEventArgs e)
    {
        buildingsResult = null;
        roomsResult = null;
        buildingId = 0;
        roomId = 0;

        if (!int.TryParse(e.Value?.ToString(), out campusId) || campusId == 0)
        {
            return;
        }

        buildingsResult =
            await SchedulingService.GetBuildingsByCampusAsync(campusId);
    }

    private async Task OnBuildingChanged(ChangeEventArgs e)
    {
        roomsResult = null;
        roomId = 0;

        if (!int.TryParse(e.Value?.ToString(), out buildingId) || buildingId == 0)
        {
            return;
        }

        roomsResult =
            await SchedulingService.GetRoomsByBuildingAsync(buildingId);
    }

    private async Task OnDepartmentChanged(ChangeEventArgs e)
    {
        programsResult = null;
        cohortsResult = null;
        programId = 0;

        if (!int.TryParse(e.Value?.ToString(), out departmentId) || departmentId == 0)
        {
            return;
        }

        programsResult =
            await SchedulingService.GetProgramsByDepartmentAsync(departmentId);
    }

    private async Task OnProgramChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out programId) || programId == 0)
        {
            cohortsResult = null;
            return;
        }

        cohortsResult = await SchedulingService.GetCohortsByProgramAsync(programId);
    }

    private void ToggleCohort(int cohortId, ChangeEventArgs e)
    {
        var isSelected = e.Value is bool value && value;

        if (isSelected)
        {
            if (!selectedCohortIds.Contains(cohortId))
            {
                selectedCohortIds.Add(cohortId);
            }
        }
        else
        {
            selectedCohortIds.Remove(cohortId);
        }
    }

    private void OnLecturersChanged(ChangeEventArgs e)
    {
        selectedLecturerIds.Clear();

        if (e.Value is string[] selectedValues)
        {
            foreach (var value in selectedValues)
            {
                if (int.TryParse(value, out var lecturerId))
                {
                    selectedLecturerIds.Add(lecturerId);
                }
            }
        }
    }
    
    private IEnumerable<LecturerDto> FilteredLecturers =>
    lecturersResult?.Items?
        .Where(l => l.IsActive &&
                    l.DepartmentId == departmentId)
    ?? Enumerable.Empty<LecturerDto>();

}