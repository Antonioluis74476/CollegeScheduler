@page "/admin/student-module-enrollments/details/{StudentId:int}/{ModuleId:int}/{TermId:int}"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

@using CollegeScheduler.DTOs.Membership
@using CollegeScheduler.Services.Interfaces
@using Microsoft.AspNetCore.Authorization

@inject IStudentModuleEnrollmentService EnrollmentService
@inject NavigationManager Navigation

@inject IAdminUserService AdminUserService
@inject IModuleService ModuleService
@inject ITermService TermService
@inject ICohortService CohortService

<PageTitle>Student Module Enrolment Details</PageTitle>

<h1>Student Module Enrolment Details</h1>

@if (isLoading)
{
    <p>Loading enrolment...</p>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}
else if (enrollment is null)
{
    <div class="alert alert-warning">
        The enrolment could not be found.
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">Student</dt>
                <dd class="col-sm-8">@studentDisplay</dd>

                <dt class="col-sm-4">Module</dt>
                <dd class="col-sm-8">@moduleDisplay</dd>

                <dt class="col-sm-4">Term</dt>
                <dd class="col-sm-8">@termDisplay</dd>

                <dt class="col-sm-4">Enrolment Type</dt>
                <dd class="col-sm-8">@enrollment.EnrollmentType</dd>

                <dt class="col-sm-4">Attend With Cohort</dt>
                <dd class="col-sm-8">@cohortDisplay</dd>

                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">@enrollment.Status</dd>

                <dt class="col-sm-4">Enrolled At</dt>
                <dd class="col-sm-8">
                    @(enrollment.EnrolledAtUtc
                                    .ToLocalTime()
                                    .ToString("dd/MM/yyyy HH:mm"))
                </dd>
            </dl>
        </div>
    </div>

    <div class="mt-3">
        <button class="btn btn-outline-secondary"
                @onclick="BackToList">
            Back
        </button>
    </div>
}

@code {
    [Parameter]
    public int StudentId { get; set; }

    [Parameter]
    public int ModuleId { get; set; }

    [Parameter]
    public int TermId { get; set; }

    private StudentModuleEnrollmentDto? enrollment;
    private bool isLoading = true;
    private string? errorMessage;

    private string studentDisplay = "Loading...";
    private string moduleDisplay = "Loading...";
    private string termDisplay = "Loading...";
    private string cohortDisplay = "Not assigned";

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            enrollment = await EnrollmentService.GetAsync(
                StudentId,
                ModuleId,
                TermId);

            if (enrollment is not null)
            {
                var students = await AdminUserService.GetStudentsAsync();

                var student = students.FirstOrDefault(
                    item => item.StudentId == enrollment.StudentId);

                studentDisplay = student is null
                    ? "Student not found"
                    : $"{student.StudentNumber} - {student.Name} {student.LastName}";

                var module = await ModuleService.GetByIdAsync(
                    enrollment.ModuleId);

                moduleDisplay = module is null
                    ? "Module not found"
                    : $"{module.Code} - {module.Title}";

                var term = await TermService.GetByIdAsync(
                    enrollment.TermId);

                termDisplay = term is null
                    ? "Term not found"
                    : term.Name;

                if (enrollment.AttendWithCohortId.HasValue)
                {
                    var cohort = await CohortService.GetByIdAsync(
                        enrollment.AttendWithCohortId.Value);

                    cohortDisplay = cohort is null
                        ? "Cohort not found"
                        : $"{cohort.Code} - {cohort.Name}";
                }
            }

        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to load the enrolment: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void BackToList()
    {
        Navigation.NavigateTo(
            "/admin/student-module-enrollments");
    }
}