@page "/admin/timetable-events"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]

@using CollegeScheduler.DTOs.Scheduling
@using CollegeScheduler.Services.Interfaces
@using Microsoft.AspNetCore.Authorization

@using CollegeScheduler.DTOs.Academic
@using CollegeScheduler.DTOs.Facilities

@inject ITimetableEventService TimetableEventService
@inject NavigationManager Navigation

@inject IAcademicYearService AcademicYearService

@inject IModuleService ModuleService
@inject ITermService TermService
@inject IRoomService RoomService

@inject IBuildingService BuildingService

<PageTitle>Timetable Events</PageTitle>

<h1>Timetable Events</h1>

<div class="mb-3">
    <button class="btn btn-primary"
            @onclick="CreateEvent">
        Create Timetable Event
    </button>
</div>

@if (isLoading)
{
    <p>Loading timetable events...</p>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}
else if (events.Count == 0)
{
    <div class="alert alert-info">
        No timetable events found.
    </div>
}
else
{

    <div class="card mb-3">
        <div class="card-header">
            Search and Filters
        </div>

        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Search</label>
                    <InputText class="form-control"
                               @bind-Value="searchText"
                               placeholder="Module, room, or session type" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Module</label>
                    <InputSelect class="form-select"
                                 @bind-Value="selectedModuleId">
                        <option value="">All Modules</option>

                        @foreach (var module in moduleNames)
                        {
                            <option value="@module.Key">@module.Value</option>
                        }
                    </InputSelect>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Term</label>
                    <InputSelect class="form-select"
                                 @bind-Value="selectedTermId">
                        <option value="">All Terms</option>

                        @foreach (var term in termNames)
                        {
                            <option value="@term.Key">@term.Value</option>
                        }
                    </InputSelect>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Room</label>
                    <InputSelect class="form-select"
                                 @bind-Value="selectedRoomId">
                        <option value="">All Rooms</option>

                        @foreach (var room in roomNames)
                        {
                            <option value="@room.Key">@room.Value</option>
                        }
                    </InputSelect>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Status</label>
                    <InputSelect class="form-select"
                                 @bind-Value="selectedStatusId">
                        <option value="">All Statuses</option>
                        <option value="1">Scheduled</option>
                        <option value="2">Cancelled</option>
                        <option value="3">Completed</option>
                    </InputSelect>
                </div>

                <div class="col-md-4">
                    <label class="form-label">From Date</label>
                    <InputDate class="form-control"
                               @bind-Value="fromDate" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">To Date</label>
                    <InputDate class="form-control"
                               @bind-Value="toDate" />
                </div>
            </div>
        </div>
    </div>

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Module</th>
                <th>Term</th>
                <th>Room</th>
                <th>Start</th>
                <th>End</th>
                <th>Session Type</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in FilteredEvents)
            {
                <tr>
                    <td>@item.TimetableEventId</td>
                    <td>
                        @(moduleNames.TryGetValue(item.ModuleId, out var moduleName)
                                        ? moduleName
                                        : $"Module {item.ModuleId}")
                    </td>
                                                                <td>
                        @(termNames.TryGetValue(item.TermId, out var termName)
                                        ? termName
                                        : $"Term {item.TermId}")
                    </td>
                                                            <td>
                        @(roomNames.TryGetValue(item.RoomId, out var roomName)
                                        ? roomName
                                        : $"Room {item.RoomId}")
                    </td>
                    <td>@item.StartUtc.ToLocalTime().ToString("ddd dd MMM yyyy HH:mm")</td>
                    <td>@item.EndUtc.ToLocalTime().ToString("ddd dd MMM yyyy HH:mm")</td>
                    <td>@item.SessionType</td>
                                                            <td>
                        @(item.EventStatusId switch
                        {
                            1 => "Scheduled",
                            2 => "Cancelled",
                            3 => "Completed",
                            _ => $"Status {item.EventStatusId}"
                        })
                    </td>
                    <td>
                         <button class="btn btn-sm btn-info me-2"
                                @onclick="() => DetailsEvent(item.TimetableEventId)">
                            Details
                        </button>

                        <button class="btn btn-sm btn-warning me-2"
                                @onclick="() => EditEvent(item.TimetableEventId)">
                            Edit
                        </button>

                        <button class="btn btn-sm btn-danger"
                                @onclick="() => DeleteEvent(item.TimetableEventId)">
                            Delete
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<TimetableEventDto> events = new();
    private bool isLoading = true;
    private string? errorMessage;

    private Dictionary<int, string> moduleNames = new();

    private Dictionary<int, string> termNames = new();

    private Dictionary<int, string> roomNames = new();


    private string searchText = "";
    private int? selectedModuleId;
    private int? selectedTermId;
    private int? selectedRoomId;
    private int? selectedStatusId;
    private DateTime? fromDate;
    private DateTime? toDate;
    

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var eventResult = await TimetableEventService.GetAllAsync();

            if (eventResult is not null)
            {
                events = eventResult.Items.ToList();
            }

            var moduleResult = await ModuleService.GetAllAsync();
            if (moduleResult is not null)
            {
                moduleNames = moduleResult.Items.ToDictionary(
                    x => x.ModuleId,
                    x => $"{x.Code} - {x.Title}");
            }

                   var academicYearResult = await AcademicYearService.GetAllAsync(
                        page: 1,
                        pageSize: 100);

            if (academicYearResult is not null)
            {
                foreach (var academicYear in academicYearResult.Items)
                {
                    var termResult = await TermService.GetByAcademicYearAsync(
                        academicYear.AcademicYearId,
                        page: 1,
                        pageSize: 100);

                    if (termResult is null)
                    {
                        continue;
                    }

                    foreach (var term in termResult.Items)
                    {
                        termNames[term.TermId] =
                            $"{academicYear.Label} - {term.Name}";
                    }
                }
            }

            for (int campusId = 1; campusId <= 1; campusId++)
            {
                var buildingResult = await BuildingService.GetByCampusAsync(
                    campusId,
                    page: 1,
                    pageSize: 100);

                if (buildingResult is null)
                    continue;

                foreach (var building in buildingResult.Items)
                {
                    var roomResult = await RoomService.GetByBuildingAsync(
                        building.BuildingId,
                        page: 1,
                        pageSize: 100);

                    if (roomResult is null)
                        continue;

                    foreach (var room in roomResult.Items)
                    {
                        roomNames[room.RoomId] =
                            $"{room.Code} - {room.Name}";
                    }
                }
            }

        }


        catch (Exception ex)
        {
            errorMessage = $"Unable to load timetable events: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void CreateEvent()
    {
        Navigation.NavigateTo("/admin/timetable-events/create");
    }

    private void EditEvent(long id)
    {
        Navigation.NavigateTo($"/admin/timetable-events/edit/{id}");
    }

    private void DeleteEvent(long id)
    {
        Navigation.NavigateTo($"/admin/timetable-events/delete/{id}");
    }

    private void DetailsEvent(long id)
    {
        Navigation.NavigateTo($"/admin/timetable-events/details/{id}");
    }

    private IEnumerable<TimetableEventDto> FilteredEvents =>
    events.Where(item =>
        (!selectedModuleId.HasValue ||
         item.ModuleId == selectedModuleId.Value)

        && (!selectedTermId.HasValue ||
            item.TermId == selectedTermId.Value)

        && (!selectedRoomId.HasValue ||
            item.RoomId == selectedRoomId.Value)

        && (!selectedStatusId.HasValue ||
            item.EventStatusId == selectedStatusId.Value)

        && (!fromDate.HasValue ||
            item.StartUtc.ToLocalTime().Date >= fromDate.Value.Date)

        && (!toDate.HasValue ||
            item.StartUtc.ToLocalTime().Date <= toDate.Value.Date)

        && (string.IsNullOrWhiteSpace(searchText)
            || GetModuleName(item.ModuleId)
                .Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || GetRoomName(item.RoomId)
                .Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || item.SessionType
                .Contains(searchText, StringComparison.OrdinalIgnoreCase)));


    private string GetModuleName(int moduleId)
    {
        return moduleNames.TryGetValue(moduleId, out var name)
            ? name
            : $"Module {moduleId}";
    }

    private string GetRoomName(int roomId)
    {
        return roomNames.TryGetValue(roomId, out var name)
            ? name
            : $"Room {roomId}";
    }
}