@page "/admin/timetable"
@attribute [Authorize(Roles = "Admin")]

@using Microsoft.AspNetCore.Authorization

<PageTitle>Timetable</PageTitle>

<div class="container-fluid py-4">

    <div class="mb-4">
        <h1 class="h3 mb-1">Timetable</h1>
        <p class="text-muted mb-0">
            Manage timetable events and their lecturer and cohort assignments.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-12 col-md-6 col-xl-4">
            <NavLink href="/admin/timetable-events" class="text-decoration-none">
                <div class="card h-100 shadow-sm dashboard-card">
                    <div class="card-body">
                        <div class="fs-2 mb-3">📅</div>
                        <h2 class="h5">Timetable Events</h2>
                        <p class="text-muted mb-0">
                            Create and manage scheduled classes.
                        </p>
                    </div>
                </div>
            </NavLink>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <NavLink href="/admin/event-statuses" class="text-decoration-none">
                <div class="card h-100 shadow-sm dashboard-card">
                    <div class="card-body">
                        <div class="fs-2 mb-3">🏷️</div>
                        <h2 class="h5">Event Statuses</h2>
                        <p class="text-muted mb-0">
                            Manage statuses such as scheduled, cancelled, and completed.
                        </p>
                    </div>
                </div>
            </NavLink>
        </div>

    </div>

   

</div>

<style>
    .dashboard-card {
        transition: transform 0.15s ease, box-shadow 0.15s ease;
        color: inherit;
    }

        .dashboard-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 .5rem 1rem rgba(0, 0, 0, .15) !important;
        }
</style>