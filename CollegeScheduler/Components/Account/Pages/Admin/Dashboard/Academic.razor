@page "/admin/academic"
@attribute [Authorize(Roles = "Admin")]

@using Microsoft.AspNetCore.Authorization

<PageTitle>Academic</PageTitle>

<div class="container-fluid py-4">

    <div class="mb-4">
        <h1 class="h3 mb-1">Academic</h1>
        <p class="text-muted mb-0">
            Manage the academic structure of the college.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-12 col-md-6 col-xl-4">
            <NavLink href="/admin/departments" class="text-decoration-none">
                <div class="card h-100 shadow-sm facility-card">
                    <div class="card-body">
                        <div class="fs-2 mb-3">🏛️</div>
                        <h2 class="h5">Departments</h2>
                        <p class="text-muted mb-0">
                            Manage academic departments.
                        </p>
                    </div>
                </div>
            </NavLink>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <NavLink href="/admin/academic-years" class="text-decoration-none">
                <div class="card h-100 shadow-sm facility-card">
                    <div class="card-body">
                        <div class="fs-2 mb-3">📅</div>
                        <h2 class="h5">Academic Years</h2>
                        <p class="text-muted mb-0">
                            Manage academic years.
                        </p>
                    </div>
                </div>
            </NavLink>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <NavLink href="/admin/modules" class="text-decoration-none">
                <div class="card h-100 shadow-sm facility-card">
                    <div class="card-body">
                        <div class="fs-2 mb-3">📚</div>
                        <h2 class="h5">Modules</h2>
                        <p class="text-muted mb-0">
                            Manage academic modules.
                        </p>
                    </div>
                </div>
            </NavLink>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <NavLink href="/admin/module-lecturers" class="text-decoration-none">
                <div class="card h-100 shadow-sm facility-card">
                    <div class="card-body">
                        <div class="fs-2 mb-3">👨‍🏫</div>
                        <h2 class="h5">Lecturer Assignments</h2>
                        <p class="text-muted mb-0">
                            Assign lecturers to modules.
                        </p>
                    </div>
                </div>
            </NavLink>
        </div>

    </div>

</div>

<style>
    .facility-card {
        transition: transform 0.15s ease, box-shadow 0.15s ease;
        color: inherit;
    }

        .facility-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }
</style>