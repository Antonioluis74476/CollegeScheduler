@page "/student/dashboard"
@rendermode InteractiveServer
@attribute [Authorize(Roles = RoleNames.Student)]

@using CollegeScheduler.Data.Identity
@using CollegeScheduler.DTOs.Profiles
@using CollegeScheduler.DTOs.Student
@using CollegeScheduler.Services.Interfaces
@using Microsoft.AspNetCore.Authorization

@inject IStudentService StudentService

<PageTitle>Student Dashboard</PageTitle>

@if (isLoading)
{
    <p><em>Loading dashboard...</em></p>
}
else
{
    <div class="mb-4">
        <h1 class="mb-1">
            Welcome back@(profile is not null ? $", {profile.Name}!" : "!")
        </h1>

        <p class="text-muted mb-0">
            Here are your next scheduled classes.
        </p>
    </div>

    <div class="row g-4">
        <div class="col-12">

            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">
                        <i class="bi bi-calendar-event me-2"></i>
                        Upcoming Classes
                    </span>

                    <span class="badge bg-primary">
                        @upcomingClasses.Count Class@(upcomingClasses.Count == 1 ? "" : "es")
                    </span>
                </div>

                <div class="card-body">
                    @if (!upcomingClasses.Any())
                    {
                        <p class="text-muted mb-0">
                            No upcoming classes found.
                        </p>
                    }
                    else
                    {
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Time</th>
                                    <th>Module</th>
                                    <th>Room</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in upcomingClasses)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">
                                                @item.StartUtc.ToLocalTime().ToString("dddd")
                                            </div>

                                            <small class="text-muted">
                                                @item.StartUtc.ToLocalTime().ToString("dd MMM yyyy")
                                            </small>
                                        </td>

                                        <td>
                                            @item.StartUtc.ToLocalTime().ToString("HH:mm")
                                            -
                                            @item.EndUtc.ToLocalTime().ToString("HH:mm")
                                        </td>

                                        <td>@item.ModuleTitle</td>
                                        <td>@item.RoomCode</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>

        </div>
    </div>
}

@code
{
    private bool isLoading = true;

    private StudentDto? profile;

    private List<StudentTimetableItemDto> upcomingClasses = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            profile = await StudentService.GetProfileAsync();

            var fromDate = DateTime.UtcNow;
            var toDate = fromDate.AddDays(60);

            var timetable =
                await StudentService.GetTimetableAsync(fromDate, toDate);

            upcomingClasses = timetable
                .Where(x => x.StartUtc >= DateTime.UtcNow)
                .OrderBy(x => x.StartUtc)
                .Take(5)
                .ToList();
        }
        finally
        {
            isLoading = false;
        }
    }
}