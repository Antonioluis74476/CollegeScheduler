@page "/student/room-booking"
@rendermode InteractiveServer
@attribute [Authorize(Roles = RoleNames.Student)]

@using CollegeScheduler.Data.Identity
@using CollegeScheduler.DTOs.Requests
@using CollegeScheduler.Services.Interfaces
@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@using CollegeScheduler.DTOs.Scheduling


@using CollegeScheduler.DTOs.Facilities


@inject IStudentService StudentService

@inject NavigationManager NavigationManager


<PageTitle>Book a Room</PageTitle>

<div class="container py-4">

    <div class="mb-4">
        <h1 class="h3 mb-1">Book a Room</h1>

        <p class="text-muted mb-0">
            Submit a room-booking request for approval.
        </p>
    </div>

    @if (!string.IsNullOrWhiteSpace(_successMessage))
    {
        <div class="alert alert-success"
             role="alert">

            <div class="fw-semibold mb-1">
                Request submitted
            </div>

            <div>
                @_successMessage
            </div>

            @if (_createdRequestId.HasValue)
            {
                <div class="mt-2">
                    Request number:
                    <strong>@_createdRequestId</strong>
                </div>
            }

            <div class="mt-3 d-flex flex-wrap gap-2">
                <button type="button"
                        class="btn btn-sm btn-success"
                        @onclick="CreateAnotherRequest">
                    Create another request
                </button>

                <a class="btn btn-sm btn-outline-success"
                   href="/student/requests">
                    View my requests
                </a>
            </div>

        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger"
             role="alert">
            @_errorMessage
        </div>
    }

    @if (!_submittedSuccessfully)
    {
        <div class="card shadow-sm">
            <div class="card-body">

                <EditForm Model="_formModel"
                          OnValidSubmit="SubmitRequestAsync">

                    <DataAnnotationsValidator />

                    <div class="row g-3">

                        <div class="col-12">
                            <label class="form-label">Booking type</label>

                            <InputSelect class="form-select"
                                         @bind-Value="_bookingType">
                                <option value="Single">Single booking</option>
                                <option value="Recurring">Recurring booking</option>
                            </InputSelect>

                            <div class="form-text">
                                Choose whether you want to book a room once or for recurring weekly sessions.
                            </div>
                        </div>

                        <div class="form-text mb-2">
                            Select the expected attendees, date and time first, then click
                            <strong>Search available rooms</strong>.
                        </div>

                        <div class="col-md-6">
                            <label for="expectedAttendees"
                                   class="form-label">
                                Expected attendees
                            </label>

                            <InputNumber id="expectedAttendees"
                                         class="form-control"
                                         @bind-Value="_formModel.ExpectedAttendees" />

                            <ValidationMessage For="@(() => _formModel.ExpectedAttendees)" />
                        </div>

                        <div class="col-md-6">
                            <label for="startDate"
                                   class="form-label">
                                Start date
                            </label>

                            <InputDate id="startDate"
                                       class="form-control"
                                       @bind-Value="_formModel.StartDate" />

                            <ValidationMessage For="@(() => _formModel.StartDate)" />
                        </div>


                        <div class="col-md-6">
                            <label for="startTime"
                                   class="form-label">
                                Start time
                            </label>

                            <InputText id="startTime"
                                       type="time"
                                       class="form-control"
                                       @bind-Value="_formModel.StartTime" />

                            <ValidationMessage For="@(() => _formModel.StartTime)" />
                        </div>

                        @if (_bookingType == "Single")
                        {
                            <div class="col-md-6">
                                <label for="endDate"
                                       class="form-label">
                                    End date
                                </label>

                                <InputDate id="endDate"
                                           class="form-control"
                                           @bind-Value="_formModel.EndDate" />

                                <ValidationMessage For="@(() => _formModel.EndDate)" />
                            </div>

                            <div class="col-md-6">
                                <label for="endTime"
                                       class="form-label">
                                    End time
                                </label>

                                <InputText id="endTime"
                                           type="time"
                                           class="form-control"
                                           @bind-Value="_formModel.EndTime" />

                                <ValidationMessage For="@(() => _formModel.EndTime)" />
                            </div>
                        }
                        else
                        {
                            <div class="col-md-6">
                                <label for="durationHours"
                                       class="form-label">
                                    Duration in hours
                                </label>

                                <InputNumber id="durationHours"
                                             class="form-control"
                                             @bind-Value="_formModel.DurationHours" />

                                <ValidationMessage For="@(() => _formModel.DurationHours)" />
                            </div>

                            <div class="col-md-6">
                                <label for="numberOfWeeks"
                                       class="form-label">
                                    Number of weeks
                                </label>

                                <InputNumber id="numberOfWeeks"
                                             class="form-control"
                                             @bind-Value="_formModel.NumberOfWeeks" />

                                <ValidationMessage For="@(() => _formModel.NumberOfWeeks)" />
                            </div>

                            <div class="col-12">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           id="studentCustomWeekdays"
                                           @bind="_useCustomDays" />

                                    <label class="form-check-label" for="studentCustomWeekdays">
                                        Choose custom weekdays
                                    </label>
                                </div>

                                @if (_useCustomDays)
                                {
                                    <label class="form-label">Repeat on</label>

                                    <div class="d-flex flex-wrap gap-3">
                                        @foreach (DayOfWeek day in Enum.GetValues<DayOfWeek>())
                                        {
                                            <div class="form-check">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       id="@($"student-{day}")"
                                                       checked="@_selectedDays.Contains(day)"
                                                       @onchange="e => ToggleDay(day, (bool)e.Value!)" />

                                                <label class="form-check-label"
                                                       for="@($"student-{day}")">
                                                    @day
                                                </label>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="form-text">
                                        Repeats every @_formModel.StartDate.DayOfWeek based on the selected start date.
                                    </div>
                                }
                            </div>

                        }


                        <div class="col-md-6">
                            <label class="form-label">Campus</label>

                            <InputSelect TValue="int?"
                                         class="form-select"
                                         Value="_selectedCampusId"
                                         ValueChanged="@((int? campusId) => OnCampusChangedAsync(campusId))"
                                         ValueExpression="@(() => _selectedCampusId)">
                                <option value="">All campuses</option>

                                @foreach (var campus in _campuses)
                                {
                                    <option value="@campus.CampusId">
                                        @campus.Name
                                    </option>
                                }
                            </InputSelect>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Building</label>

                            <InputSelect class="form-select"
                                         @bind-Value="_selectedBuildingId">
                                <option value="">All buildings</option>

                                @foreach (var building in _buildings)
                                {
                                    <option value="@building.BuildingId">
                                        @building.Name
                                    </option>
                                }
                            </InputSelect>
                        </div>

                        <div class="col-12">
                            <button type="button"
                                    class="btn btn-outline-primary"
                                    @onclick="LoadAvailableRoomsAsync"
                                    disabled="@_isLoadingRooms">

                                @if (_isLoadingRooms)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Loading rooms...</span>
                                }
                                else
                                {
                                    <span>Find available rooms</span>
                                }

                            </button>
                        </div>

                        <div class="col-md-6">
                            <label for="roomId"
                                   class="form-label">
                                Room
                            </label>

                            <InputSelect id="roomId"
                                         class="form-select"
                                         @bind-Value="_formModel.RoomId">

                                <option value="0">Select a room</option>

                                @if (_bookingType == "Recurring")
                                {
                                    @foreach (var room in _recurringAvailableRooms)
                                    {
                                        <option value="@room.RoomId">
                                            @room.RoomCode - @room.RoomName
                                            (@room.AvailableOccurrences/@room.TotalOccurrences available)
                                        </option>
                                    }
                                }
                                else
                                {
                                    @foreach (var room in _availableRooms)
                                    {
                                        <option value="@room.RoomId">
                                            @room.Code - @room.Name
                                        </option>
                                    }
                                }

                            </InputSelect>

                            <ValidationMessage For="@(() => _formModel.RoomId)" />
                        </div>

                        <div class="col-12">
                            <label for="purpose"
                                   class="form-label">
                                Purpose
                            </label>

                            <InputTextArea id="purpose"
                                           class="form-control"
                                           rows="4"
                                           placeholder="Explain why you need the room..."
                                           @bind-Value="_formModel.Purpose" />

                            <ValidationMessage For="@(() => _formModel.Purpose)" />
                        </div>

                    </div>

                    <ValidationSummary class="text-danger mt-3" />

                    <div class="d-flex flex-wrap gap-2 mt-4">

                        <button type="submit"
                                class="btn btn-primary"
                                disabled="@_isSubmitting">

                            @if (_isSubmitting)
                            {
                                <span class="spinner-border
                                                     spinner-border-sm me-2"
                                      aria-hidden="true">
                                </span>

                                <span>Submitting...</span>
                            }
                            else
                            {
                                <span>Submit request</span>
                            }

                        </button>

                        <button type="button"
                                class="btn btn-outline-secondary"
                                @onclick="ResetForm"
                                disabled="@_isSubmitting">
                            Reset
                        </button>

                        <a class="btn btn-outline-secondary"
                           href="/student/requests">
                            Cancel
                        </a>

                    </div>

                </EditForm>

            </div>
        </div>
    }

</div>

@code {
    private RoomBookingFormModel _formModel = CreateInitialForm();

    

    private bool _isSubmitting;
    private bool _isLoadingRooms;
    private bool _submittedSuccessfully;

    private long? _createdRequestId;
    private string? _successMessage;
    private string? _errorMessage;

    private List<AvailableRoomDto> _availableRooms = new();

    private List<RecurringAvailableRoomDto>
    _recurringAvailableRooms = new();

    private string _bookingType = "Single";

    private bool _useCustomDays;
    private readonly HashSet<DayOfWeek> _selectedDays = [];

    private List<CampusDto> _campuses = [];

    private List<CollegeScheduler.DTOs.Facilities.BuildingDto> _buildings = [];

    private int? _selectedCampusId;
    private int? _selectedBuildingId;

    protected override async Task OnInitializedAsync()
    {
        _campuses = await StudentService.GetCampusesAsync();
    }
    

    private async Task SubmitRequestAsync()
    {
        _errorMessage = null;
        _successMessage = null;

        if (!TimeSpan.TryParse(_formModel.StartTime, out var startTime))
        {
            _errorMessage = "Please enter a valid start time.";
            return;
        }

        DateTime localStart;
        DateTime localEnd;

        if (_bookingType == "Recurring")
        {
            localStart = _formModel.StartDate.Date.Add(startTime);
            localEnd = localStart.AddHours(_formModel.DurationHours);
        }
        else
        {
            if (!TimeSpan.TryParse(_formModel.EndTime, out var endTime))
            {
                _errorMessage = "Please enter a valid end time.";
                return;
            }

            localStart = _formModel.StartDate.Date.Add(startTime);
            localEnd = _formModel.EndDate.Date.Add(endTime);
        }

        if (localStart < DateTime.Now)
        {
            _errorMessage =
                "The booking start time must be in the future.";
            return;
        }

        if (localEnd <= localStart)
        {
            _errorMessage =
                "The booking end time must be after the start time.";
            return;
        }

        _isSubmitting = true;

        try
        {
            var dto = new RoomBookingRequestCreateDto
            {
                RoomId = _formModel.RoomId,
                StartUtc = DateTime.SpecifyKind(
                        localStart,
                        DateTimeKind.Local)
                    .ToUniversalTime(),

                EndUtc = DateTime.SpecifyKind(
                        localEnd,
                        DateTimeKind.Local)
                    .ToUniversalTime(),

                Purpose = _formModel.Purpose.Trim(),
                ExpectedAttendees = _formModel.ExpectedAttendees
            };

            var result =
                await StudentService.CreateRoomBookingRequestAsync(dto);

            _createdRequestId = result?.RequestId;
            _successMessage =
                result?.Message
                ?? "Room-booking request submitted successfully.";

            _submittedSuccessfully = true;
        }
        catch (HttpRequestException ex)
        {
            _errorMessage = CleanErrorMessage(ex.Message);
        }
        catch (Exception)
        {
            _errorMessage =
                "An unexpected error occurred while submitting the request.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void ResetForm()
    {
        _formModel = CreateInitialForm();
        _errorMessage = null;
        _successMessage = null;
        _createdRequestId = null;
    }

    private void CreateAnotherRequest()
    {
        ResetForm();
        _submittedSuccessfully = false;
    }

    private static RoomBookingFormModel CreateInitialForm()
    {
        var nextHour = DateTime.Now
            .AddHours(1)
            .AddMinutes(-DateTime.Now.Minute)
            .AddSeconds(-DateTime.Now.Second)
            .AddMilliseconds(-DateTime.Now.Millisecond);

        return new RoomBookingFormModel
        {
            StartDate = nextHour.Date,
            StartTime = nextHour.ToString("HH:mm"),
            EndDate = nextHour.Date,
            EndTime = nextHour.AddHours(1).ToString("HH:mm"),
            ExpectedAttendees = 1



        };
    }

    private void ToggleDay(DayOfWeek day, bool isSelected)
    {
        if (isSelected)
        {
            _selectedDays.Add(day);
        }
        else
        {
            _selectedDays.Remove(day);
        }
    }

    private async Task LoadAvailableRoomsAsync()
    {
        _isLoadingRooms = true;

        _availableRooms.Clear();
        _recurringAvailableRooms.Clear();

        _formModel.RoomId = 0;
        _errorMessage = null;

        try
        {
            if (_bookingType == "Recurring")
            {
                var recurringQuery = new RecurringRoomSearchQuery
                {
                    StartDate = DateOnly.FromDateTime(_formModel.StartDate),
                    StartTime = TimeOnly.Parse(_formModel.StartTime),
                    DurationMinutes = _formModel.DurationHours * 60,
                    NumberOfWeeks = _formModel.NumberOfWeeks,
                    MinimumCapacity = _formModel.ExpectedAttendees,

                    CampusId = _selectedCampusId,
                    BuildingId = _selectedBuildingId,

                    DaysOfWeek = _useCustomDays
                        ? _selectedDays.ToList()
                        : [],
                };

                _recurringAvailableRooms =
                    await StudentService
                        .GetRecurringAvailableRoomsAsync(
                            recurringQuery);
            }
            else
            {
                var startDateTime =
                    _formModel.StartDate.Date.Add(
                        TimeSpan.Parse(_formModel.StartTime));

                var endDateTime =
                    _formModel.EndDate.Date.Add(
                        TimeSpan.Parse(_formModel.EndTime));

                var query = new RoomSearchQuery
                {
                    StartUtc = DateTime.SpecifyKind(startDateTime, DateTimeKind.Utc),
                    EndUtc = DateTime.SpecifyKind(endDateTime, DateTimeKind.Utc),

                    MinCapacity = _formModel.ExpectedAttendees,

                    CampusId = _selectedCampusId,
                    BuildingId = _selectedBuildingId
                };

                _availableRooms =
                    await StudentService
                        .GetAvailableRoomsAsync(query);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = CleanErrorMessage(ex.Message);
        }
        finally
        {
            _isLoadingRooms = false;
        }
    }

    private static string CleanErrorMessage(string message)
    {
        if (string.IsNullOrWhiteSpace(message))
        {
            return "The room-booking request could not be submitted.";
        }

        return message.Trim('"');
    }

    private sealed class RoomBookingFormModel
    {
        [Range(1, int.MaxValue,
            ErrorMessage = "Please enter a valid room ID.")]
        public int RoomId { get; set; }

        [Required(ErrorMessage = "A start date is required.")]
        public DateTime StartDate { get; set; }

        [Required(ErrorMessage = "A start time is required.")]
        public string StartTime { get; set; } = "";

        [Required(ErrorMessage = "An end date is required.")]
        public DateTime EndDate { get; set; }

        [Required(ErrorMessage = "An end time is required.")]
        public string EndTime { get; set; } = "";

        [Range(1, 12, ErrorMessage = "Duration must be between 1 and 12 hours.")]
        public int DurationHours { get; set; } = 1;

        [Range(1, 52, ErrorMessage = "Number of weeks must be between 1 and 52.")]
        public int NumberOfWeeks { get; set; } = 12;

        [Required(ErrorMessage = "Please provide a purpose.")]
        [StringLength(500, MinimumLength = 3, ErrorMessage = "The purpose must be between 3 and 500 characters.")]
        public string Purpose { get; set; } = "";

        [Range(
            1,
            1000,
            ErrorMessage =
                "Expected attendees must be between 1 and 1000.")]
        public int ExpectedAttendees { get; set; }
    }

    private async Task OnCampusChangedAsync(int? campusId)
    {
        _selectedCampusId = campusId;
        _selectedBuildingId = null;
        _buildings.Clear();

        _availableRooms.Clear();
        _recurringAvailableRooms.Clear();
        _formModel.RoomId = 0;

        if (campusId.HasValue)
        {
            _buildings = await StudentService
                .GetBuildingsByCampusAsync(campusId.Value);
        }
    }

}